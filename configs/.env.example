# 环境变量覆盖示例：复制为 .env 或直接导出。
# 所有变量以 JOBSROBOT_ 开头，未设置的项回落到 configs/config.yaml。

# —— 应用 ——
JOBSROBOT_APP_ENV=development
JOBSROBOT_APP_DEBUG=true
JOBSROBOT_API_PREFIX=/api/v1

# —— 服务 ——
JOBSROBOT_SERVER_HOST=0.0.0.0
JOBSROBOT_SERVER_PORT=8090

# —— PostgreSQL（docker compose 默认映射到 55432）——
JOBSROBOT_DB_HOST=127.0.0.1
JOBSROBOT_DB_PORT=55432
JOBSROBOT_DB_USER=jobsrobot
JOBSROBOT_DB_PASSWORD=jobsrobot
JOBSROBOT_DB_NAME=jobsrobot
JOBSROBOT_DB_SSLMODE=disable
JOBSROBOT_DB_AUTO_MIGRATE=true

# —— Redis（docker compose 默认映射到 56379）——
JOBSROBOT_REDIS_ADDR=127.0.0.1:56379
JOBSROBOT_REDIS_PASSWORD=
JOBSROBOT_REDIS_DB=0

# —— JWT（生产必须替换，至少 32 字节）——
JOBSROBOT_JWT_SECRET=dev-only-change-me-2f8c1d9a4b6e7f0c3a5b8d1e4f7a0c3b6d9e2f5a8c1b4d7e
JOBSROBOT_JWT_ACCESS_TTL=2h
JOBSROBOT_JWT_REFRESH_TTL=168h

# —— 认证 ——
JOBSROBOT_AUTH_REGISTER_NEED_VERIFY=true
# 仅联调期可置 true，接口会直接返回验证码，便于自动化测试
JOBSROBOT_AUTH_EXPOSE_CODE_IN_RESPONSE=false

# —— 认证限流（IP 维度；置 0 或 enabled=false 表示不限流）——
JOBSROBOT_AUTH_RL_ENABLED=true
JOBSROBOT_AUTH_RL_SEND_CODE_LIMIT=10
JOBSROBOT_AUTH_RL_SEND_CODE_WINDOW=1h
JOBSROBOT_AUTH_RL_REGISTER_LIMIT=20
JOBSROBOT_AUTH_RL_REGISTER_WINDOW=1h
JOBSROBOT_AUTH_RL_LOGIN_LIMIT=30
JOBSROBOT_AUTH_RL_LOGIN_WINDOW=10m
JOBSROBOT_AUTH_RL_FORGOT_LIMIT=10
JOBSROBOT_AUTH_RL_FORGOT_WINDOW=1h
JOBSROBOT_AUTH_RL_RESET_LIMIT=20
JOBSROBOT_AUTH_RL_RESET_WINDOW=1h
# 安装向导（POST /system/setup、POST /system/setup/mail/test）
JOBSROBOT_AUTH_RL_SETUP_LIMIT=10
JOBSROBOT_AUTH_RL_SETUP_WINDOW=1h

# —— 首次安装向导（默认开放）——
# 有界面部署：第一次打开前端会被强制跳到 /setup，由运维自己创建管理员
# 并现场配置、验证 SMTP。向导只在「尚无可用管理员」时可用，之后永久失效（409）。
JOBSROBOT_AUTH_SETUP_ENABLED=true
# 测试邮件默认收件人；留空表示由请求体指定（通常就是刚创建的管理员邮箱）
JOBSROBOT_AUTH_SETUP_TEST_MAIL_TO=

# —— 初始管理员自举（默认关闭，仅无界面/容器部署使用）——
# 背景：配置 SMTP 必须先登录后台，登录又必须先有账号。无界面部署没有 /setup 可用，
# 此时置 true，API/worker 启动时会自动补齐一个管理员，凭据打印在启动日志（WARN 级）
# 并写入凭据文件。幂等：只要已有一名可用管理员就完全跳过，不会改动既有账号。
#
# 注意：与 JOBSROBOT_AUTH_SETUP_ENABLED 不能同时为 true——启动自举会先建号，
# 系统立刻变成「已初始化」，安装向导就永远用不上了（同时开启会直接报配置错误）。
JOBSROBOT_AUTH_BOOTSTRAP_ENABLED=false
JOBSROBOT_AUTH_BOOTSTRAP_EMAIL=admin@jobs-robot.local
# 留空 = 自动生成 16 位随机强密码（推荐：避免口令进入配置文件/环境变量）
# 填写后日志只打印「(来自配置，未打印)」，不会把该口令写进日志
JOBSROBOT_AUTH_BOOTSTRAP_PASSWORD=
JOBSROBOT_AUTH_BOOTSTRAP_NICKNAME=初始管理员
# 凭据文件路径（权限 0600，目录自动创建）；留空表示不写文件
JOBSROBOT_AUTH_BOOTSTRAP_CREDENTIAL_FILE=var/bootstrap-admin.txt

# —— 邮件 ——
# 说明：邮件配置也可在后台「系统设置 - 邮件设置」中在线修改（保存即生效），
# 数据库中的设置优先级高于此处与环境变量。
# console：验证码打印到服务日志；smtp：真实发信
JOBSROBOT_MAIL_DRIVER=console
# 系统邮件（验证码/找回密码/改密通知等）在收件箱显示的发件人名称。
# 中间是 U+00B7 中点（·），不是 ASCII 句点；留空回退 JOBSROBOT_MAIL_FROM_NAME。
JOBSROBOT_MAIL_SYSTEM_FROM_NAME=直招好工作 · 系统通知
JOBSROBOT_MAIL_FROM_NAME=直招好工作
JOBSROBOT_MAIL_FROM_ADDRESS=no-reply@jobs-robot.local
JOBSROBOT_MAIL_SMTP_HOST=
JOBSROBOT_MAIL_SMTP_PORT=465
JOBSROBOT_MAIL_SMTP_USERNAME=
JOBSROBOT_MAIL_SMTP_PASSWORD=
JOBSROBOT_MAIL_SMTP_TLS=true

# —— 爬虫 ——
JOBSROBOT_CRAWLER_ENABLED=true
JOBSROBOT_CRAWLER_SCHEDULE=0 */6 * * *
JOBSROBOT_CRAWLER_WORKERS=4
JOBSROBOT_CRAWLER_DELAY=2s
JOBSROBOT_CRAWLER_RESPECT_ROBOTS=true

# 以标准身份声明 AI 机器人：站长据此识别与联系
JOBSROBOT_CRAWLER_BOT_NAME=JobsRobotBot
JOBSROBOT_CRAWLER_BOT_VERSION=1.0
JOBSROBOT_CRAWLER_CONTACT_EMAIL=crawler@jobs-robot.local
JOBSROBOT_CRAWLER_HOMEPAGE=https://jobs-robot.local/bot
JOBSROBOT_CRAWLER_IS_AI=true

JOBSROBOT_CRAWLER_HEADLESS_ENABLED=true

# 收集范围（逗号分隔）
JOBSROBOT_CRAWLER_SCOPE_JOB_TYPES=技术,产品,设计,运营,市场,职能
JOBSROBOT_CRAWLER_SCOPE_INDUSTRIES=互联网,人工智能,金融科技,智能制造,新能源
JOBSROBOT_CRAWLER_SCOPE_EMPLOYMENT_TYPES=全职,实习,校招,社招
JOBSROBOT_CRAWLER_SCOPE_EXCLUDE_KEYWORDS=外包,劳务派遣,中介

# —— 日志 ——
JOBSROBOT_LOG_LEVEL=info
JOBSROBOT_LOG_FORMAT=console
